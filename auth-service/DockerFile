FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY auth-service/package.json ./auth-service/package.json
COPY packages/database/package.json ./packages/database/package.json

RUN npm ci

COPY packages/database ./packages/database
COPY auth-service ./auth-service

RUN npm run build --workspace=@healthcare-scheduling/database \
	&& npm run build --workspace=auth-service \
	&& npm pack --workspace=@healthcare-scheduling/database --pack-destination /tmp \
	&& npm pack --workspace=auth-service --pack-destination /tmp

FROM node:24-alpine

WORKDIR /app

COPY --from=build /tmp/*.tgz /tmp/

RUN npm init --yes \
	&& npm install --omit=dev /tmp/*.tgz \
	&& rm -rf /root/.npm /tmp/*.tgz

COPY --from=build /app/packages/database/dist ./packages/database/dist
COPY --from=build /app/auth-service/package.json ./auth-service/package.json
COPY --from=build /app/auth-service/dist ./auth-service/dist

USER node

EXPOSE 3001

CMD ["node", "auth-service/dist/main.js"]