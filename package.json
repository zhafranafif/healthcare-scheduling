{
  "name": "healthcare-scheduling-root",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "auth-service",
    "scheduling-service",
    "notification-service",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "contract:emit": "prisma contract emit",
    "db:migrate": "prisma migrate deploy",
    "compose:up": "docker compose up -d --build",
    "compose:ps": "docker compose ps",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.6.2",
    "@types/node": "^26.6.4",
    "@nestjs/schematics": "^12.0.0",
    "prisma": "8.0.0-rc.20",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.14",
    "dotenv": "^18.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20260901.1": true,
    "bcrypt@6.0.0": true,
    "@apollo/protobufjs@1.2.8": true
  }
}
